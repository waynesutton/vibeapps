# ---------------------------------------------------------------------------
# Frontend env (Vite). Copy to .env.local — never commit .env.local.
#
#   cp .env.example .env.local
#
# Only VITE_-prefixed vars are exposed to the browser bundle. Everything the
# backend needs lives in the Convex deployment env instead (see below).
# ---------------------------------------------------------------------------

# Written automatically by `npx convex dev` the first time you link a
# deployment — you normally do not set this by hand.
VITE_CONVEX_URL=

# Clerk publishable key (Clerk dashboard → API keys). Safe to expose.
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
# Also required in the Convex env — convex/auth.config.js reads it there.
VITE_CLERK_FRONTEND_API_URL=

# ---------------------------------------------------------------------------
# Convex deployment env — set these with the CLI, NOT in this file:
#
#   npx convex env set CLERK_SECRET_KEY sk_test_...
#   npx convex env list
#
# Required for auth:
#   VITE_CLERK_FRONTEND_API_URL   Clerk Frontend API URL (convex/auth.config.js)
#   CLERK_JWT_KEY                 Clerk JWT verification key
#   CLERK_SECRET_KEY              Clerk backend API key
#   CLERK_WEBHOOK_SECRET          Svix signing secret for the Clerk webhook
#
# Required by convex/convex.config.ts (deploys fail without them):
#   FIRECRAWL_API_KEY             Firecrawl component
#   CONTEXT_DEV_API_KEY           context.dev component (video transcripts)
#
# Optional / feature-specific:
#   RESEND_API_KEY                Resend component — email sending
#   ADMIN_EMAIL                   Recipient for admin alert emails
#   GITHUB_TOKEN                  GitHub API lookups
#   LUMA_API_KEY                  Luma event import
# ---------------------------------------------------------------------------
