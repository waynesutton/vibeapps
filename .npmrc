# @waynesutton/agent-ready pins @convex-dev/workpool ^0.3.0 while
# @convex-dev/resend needs ^0.4.10. Both run fine on 0.4.10 (prod is on it),
# so skip npm's strict peer resolution until agent-ready widens its range.
legacy-peer-deps=true
# Side effect: npm no longer auto-installs peers, so anything a dependency
# needs at runtime through a peer range must be a direct dependency here.
# zod is one (the ai SDK and @ai-sdk/* import zod/v4 inside Convex functions).
